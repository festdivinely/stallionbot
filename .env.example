# Copy this file to .env and fill in your real values.
# .env is ignored by git; this example file is safe to commit.

# Your app's ID from developers.deriv.com
DERIV_APP_ID=

# Your Deriv API token (DEMO account only)
DERIV_API_TOKEN=

# Safety switch: the bot only trades on a demo account
DERIV_ACCOUNT_TYPE=demo
