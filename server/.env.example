# Copy this file to server/.env and fill in your real values.
# .env is ignored by git; this example file is safe to commit.

# Your app's ID from developers.deriv.com
DERIV_APP_ID=

# Your Deriv API token (DEMO account only)
DERIV_API_TOKEN=

# Safety switch: the bot only trades on a demo account
DERIV_ACCOUNT_TYPE=demo

# Optional: which demo account to use. Leave blank to auto-pick your demo account.
DERIV_ACCOUNT_ID=

# ===== HTTP API (src/api, from nodejs-bot-backend) =====
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DEV_MODE=

# MongoDB
DB_username=
MONGO_PASSWORD=
MONGODB_URI=
MAX_POOL_SIZE=
SERVER_SELECTION_TIMEOUT=
SOCKET_TIMEOUT=

# Login tokens (JWT). PRIVATE_KEY / PUBLIC_KEY are the PEM key contents.
JWT_SECRET=
PRIVATE_KEY=
PUBLIC_KEY=
ISSUER=
AUDIENCE=
ENCRYPTION_KEY=

# Image uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
EMAIL_SENDER=
EMAIL_PASSWORD=
ADMIN_EMAIL=
LOG_RECIPIENT_EMAIL=
EMAIL_SERVICE_DOMAIN=

# Other services
NODE_JS_API_URL=
FASTAPI_URL=
REDIS_URL=

# Security
FRONTEND_URL=
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=
