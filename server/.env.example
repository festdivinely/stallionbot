# Copy this file to server/.env and fill in your real values.
# .env is ignored by git; this example file is safe to commit.

# Your app's ID from developers.deriv.com
DERIV_APP_ID=

# Your Deriv API token. It may see a demo and a real account; the app starts in Demo and only
# trades real money when the user switches to Real in the app.
DERIV_API_TOKEN=

# Optional: which accounts to use. Leave blank to auto-pick the active demo / real account.
DERIV_ACCOUNT_ID=
DERIV_REAL_ACCOUNT_ID=

# REQUIRED to trade: the app accounts (emails) allowed to use the Deriv token above, comma
# separated. Anyone can sign up to the app; only these can see the balance, quote and trade.
TRADER_EMAILS=

# Secret the bot runner must send (header X-Internal-Key) to report bot progress. Long random text.
INTERNAL_API_KEY=

# Risk limits per user per day (server/src/risk). Demo:
RISK_MAX_STAKE=50
RISK_MAX_OPEN=5
RISK_MAX_TRADES_PER_DAY=200
RISK_DAILY_LOSS_LIMIT=200
RISK_MIN_INTERVAL_MS=1000
# Real money (stricter):
RISK_REAL_MAX_STAKE=10
RISK_REAL_MAX_OPEN=3
RISK_REAL_MAX_TRADES_PER_DAY=50
RISK_REAL_DAILY_LOSS_LIMIT=50
RISK_REAL_MIN_INTERVAL_MS=1500

# ===== HTTP API (src/api, from nodejs-bot-backend) =====
# Set to production on the hosted server (hides error details from replies)
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DEV_MODE=

# MongoDB
DB_username=
MONGO_PASSWORD=
MONGODB_URI=
MAX_POOL_SIZE=
SERVER_SELECTION_TIMEOUT=
SOCKET_TIMEOUT=

# Login tokens (JWT). PRIVATE_KEY / PUBLIC_KEY are the PEM key contents.
JWT_SECRET=
PRIVATE_KEY=
PUBLIC_KEY=
ISSUER=
AUDIENCE=
ENCRYPTION_KEY=

# Image uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email: sent by this server through Gmail (smtp.gmail.com, port 465), see src/api/utility/*Email.js.
# EMAIL_SENDER = the Gmail address; EMAIL_PASSWORD = a Gmail "app password" (not the normal password).
EMAIL_SENDER=
EMAIL_PASSWORD=
ADMIN_EMAIL=
LOG_RECIPIENT_EMAIL=
EMAIL_SERVICE_DOMAIN=

# Other services
NODE_JS_API_URL=
FASTAPI_URL=
REDIS_URL=

# Security
FRONTEND_URL=
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=
