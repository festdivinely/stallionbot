# Copy this file to apps/mobile/.env and fill in your values.
# .env is ignored by git; this example file is safe to commit.
# Everything starting with EXPO_PUBLIC_ is built into the app, so NEVER put secrets here.

# The backend the app talks to (server/ in this repo).
# Deployed:          https://nodejs-bots-backend.onrender.com
# Your own computer: http://<your-PC-LAN-IP>:3000   (phone and PC on the same Wi-Fi)
EXPO_PUBLIC_API_URL=
